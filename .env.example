# Copy to .env (next to docker-compose.yml) to change console settings,
# then run `docker compose up -d` again.

# Console port (default 8090)
EASYOVL_PORT=8090

# 0.0.0.0   = anyone on your LAN can open it (default, password protected)
# 127.0.0.1 = only this computer can open the console
EASYOVL_BIND=0.0.0.0
